# Docker deployment environment. Copy to .env and replace values.
DB_HOST=42.193.151.196
DB_PORT=3306
DB_NAME=feilv
DB_USERNAME=root
DB_PASSWORD=change-me
SERVER_PORT=8080
ADMIN_WEB_PORT=5173
# USER mini program: preserve the existing AppID. AppSecrets are backend-only.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# RIDER must use a different real AppID; missing credentials never fall back to USER.
WECHAT_RIDER_APP_ID=
WECHAT_RIDER_APP_SECRET=
# Required independent JWT signing secret (at least 32 random bytes; not CONFIG_ENCRYPTION_KEY).
# Cutover invalidates old tokens: schedule manual re-login for users/riders/admins.
JWT_SECRET=
# Demo SMS is never production authentication; only explicit local/development can enable it.
AUTH_DEMO_SMS_ENABLED=false
# Required for backend WeChat settings writes. Generate once: openssl rand -base64 32
# Persist/backup this key outside the database. Changing it breaks decryption of existing config.
CONFIG_ENCRYPTION_KEY=
