<view class="page detail-page">
  <view class="notice">承接订单只读详情。仅当前承运骑手可读；履约与转派请返回工作台操作。</view>
  <view class="notice" wx:if="{{invalid}}">订单ID无效，请从工作台进入。</view>
  <view class="card order-panel" wx:if="{{error}}"><view class="panel-title">详情暂未确认</view><view class="error">{{error}}</view><button class="outline-button" bindtap="load" disabled="{{loading}}">重新核实读取权限</button></view>
  <view class="empty" wx:if="{{loading && !order}}">正在读取承接订单…</view>
  <block wx:if="{{allowed && order}}">
    <view class="card service-header"><view class="service-type">{{order.typeText}}</view><view class="service-status">{{order.statusText}}</view><view class="status-description">以服务端当前状态和归属为准；本页不提供发布者操作。</view><button class="quiet-button" bindtap="load" disabled="{{loading}}">刷新状态</button></view>
    <view class="card order-panel" wx:if="{{!order.isService}}"><view class="panel-title">履约信息</view><view class="route-node"><text class="route-marker">取</text><view><view class="address-text">{{order.fromAddress}}</view><view>{{order.fromContact}} {{order.fromPhone}}</view></view></view><view class="route-node"><text class="route-marker">送</text><view><view class="address-text">{{order.toAddress}}</view><view>{{order.toContact}} {{order.toPhone}}</view></view></view><view class="info-row">物品 / 事项：{{order.goodsDesc || '无'}}</view><block wx:if="{{order.orderType === 'BUY'}}"><view class="info-row">预计商品总价：{{order.goodsBudgetText}}</view><view class="form-note">商品款双方另行结算，不计入跑腿费或平台支付、分账；未记录不代表零元。</view></block><view class="pickup-panel" wx:if="{{order.pickupCode}}">真实取件码：{{order.pickupCode}}</view></view>
    <view class="card order-panel" wx:if="{{order.isService}}"><view class="panel-title">{{order.modeText}}</view><view class="address-text">{{order.taskMode === 'ONLINE' ? '线上任务 · 无需地址' : task.locationAddress || order.locationAddress || order.fromAddress || '待核实'}}</view><view wx:if="{{task.contact}}">联系人：{{task.contact}} {{task.phone}}</view><view wx:if="{{order.isTransport || task.serviceTime || order.serviceTime}}">服务时间：{{task.serviceTime || order.serviceTime || '待核实'}}</view><view class="form-note">无需取件码、配送轨迹或位置上报。</view></view>
    <view class="card order-panel" wx:if="{{order.orderType === 'CUSTOM'}}"><view class="panel-title">任务说明</view><view class="error" wx:if="{{taskError}}">{{taskError}}<button class="outline-button" bindtap="loadTask" disabled="{{loading || taskLoading}}">重读任务资料</button></view><block wx:if="{{task}}"><view wx:if="{{!order.isTransport}}">{{task.title}}</view><view class="task-content">{{task.content}}</view><view wx:if="{{!order.isTransport}}"><text wx:for="{{task.tags}}" wx:key="id">{{item.name}} </text></view><view wx:if="{{task.priceText}}">发布总价：¥{{task.priceText}}</view><block wx:if="{{task.hasShares}}"><view>骑手预计所得：¥{{task.riderShareText}}</view><view>平台分成：¥{{task.platformShareText}}</view></block><view class="form-note">分成仅展示服务端值；最终结算受售后等规则影响，以钱包明细为准，不按固定比例推算。</view></block></view>
    <view class="card order-panel"><view class="panel-title">订单资料</view><view class="info-row">{{order.isService ? '发布总价' : '订单金额'}}：{{order.amountText === '待核实' ? '待核实' : '¥' + order.amountText}}</view><view class="info-row">订单编号：{{order.orderNo}}</view><view class="info-row">创建时间：{{order.createdText}}</view></view>
  </block>
  <button class="secondary" bindtap="workbench">返回工作台</button>
</view>
