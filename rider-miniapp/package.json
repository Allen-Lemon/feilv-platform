{
  "name": "feilv-rider-miniapp",
  "version": "1.0.0",
  "private": true,
  "description": "飞毛腿独立骑手微信原生小程序；无第三方运行时依赖",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "check": "node scripts/check-native.cjs",
    "check:wechat": "node scripts/compile-wechat.cjs",
