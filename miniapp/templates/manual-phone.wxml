<template name="manualPhoneForm">
  <view class="manual-phone-form">
    <view class="manual-phone-field"><label class="manual-phone-label" for="binding-mobile">手动填写手机号</label><input id="binding-mobile" class="manual-phone-input" type="number" maxlength="11" value="{{manualMobile}}" data-field="manualMobile" bindinput="manualPhoneInput" disabled="{{manualDisabled}}" placeholder="请输入本人使用的11位手机号"/></view>
    <view class="manual-phone-field"><label class="manual-phone-label" for="binding-code">短信验证码</label><view class="manual-phone-code-row"><input id="binding-code" class="manual-phone-input" type="number" maxlength="6" value="{{manualCode}}" data-field="manualCode" bindinput="manualPhoneInput" disabled="{{manualDisabled}}" placeholder="6位验证码"/><button class="manual-phone-send" bindtap="sendPhoneSms" loading="{{phoneSending}}" disabled="{{manualDisabled || phoneCooling > 0}}">{{phoneSmsLabel}}</button></view></view>
    <view wx:if="{{phoneSmsMock}}" class="manual-phone-demo">演示模式：未发送真实短信。测试验证码 {{phoneDemoCode}}，请手动填写；生产环境不可开启演示回传。</view>
    <button class="manual-phone-submit" bindtap="bindManualPhone" loading="{{binding}}" disabled="{{manualDisabled}}">{{binding ? '正在验证并绑定…' : '验证并绑定手机号'}}</button>
    <view class="manual-phone-hint">必须通过短信验证码验证，不能仅填写号码直接绑定。若短信服务尚未配置，请使用微信授权。</view>
  </view>
</template>
