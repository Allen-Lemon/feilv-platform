.login-page {
  padding-top: 36rpx;
}

.login-intro {
  margin: 0 12rpx 36rpx;
}

.login-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  margin-bottom: 30rpx;
  border-radius: 32rpx;
  background: #C94320;
  color: #FFFFFF;
  font-size: 56rpx;
  font-weight: 700;
  box-shadow: 12rpx 12rpx 0 #FFF0E8;
}

.login-card {
  padding-top: 32rpx;
}

.legal-links {
  display: flex;
  margin: -4rpx 0 12rpx 54rpx;
}

.legal-links .link {
  margin-right: 26rpx;
}

/* 微信登录使用原生 button + wx.login，绿色仅用于平台身份入口。 */
.wechat-button {
  background: #087F40;
  color: #FFFFFF;
}

.wechat-button[disabled] {
  background: #EAECF0;
  color: #667085;
}

.wechat-symbol {
  position: relative;
  width: 48rpx;
  height: 38rpx;
  margin-right: 18rpx;
}

.wechat-bubble {
  position: absolute;
  top: 0;
  left: 0;
  width: 32rpx;
  height: 26rpx;
  border: 2rpx solid #FFFFFF;
  border-radius: 50%;
}

.bubble-small {
  top: 13rpx;
  left: 19rpx;
  width: 28rpx;
  height: 23rpx;
  background: #087F40;
}

.sms-toggle {
  margin: 16rpx auto -8rpx;
}

.sms-row .small {
  max-width: 240rpx;
  font-size: 24rpx;
}

.login-footnote {
  padding: 0 16rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.85;
}

.footnote-title {
  margin-bottom: 8rpx;
  color: #202939;
  font-weight: 600;
}
