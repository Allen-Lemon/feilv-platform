<view class="page"><view class="card">
  <view class="title">欢迎使用飞毛腿</view><view class="hint">微信登录无需手机号。下单联系人、骑手入驻所需电话由您手动填写。</view>
  <checkbox-group bindchange="consent"><label><checkbox value="yes" checked="{{agreed}}" color="#176B52"/>我已阅读并同意以下说明</label></checkbox-group>
  <view class="row"><text class="link" data-kind="service" bindtap="legal">服务说明</text><text class="link" data-kind="privacy" bindtap="legal">隐私说明</text></view>
  <button class="primary" loading="{{busy}}" disabled="{{busy || sending}}" bindtap="wechat">微信一键登录</button>
  <view class="hint">开发工具游客 AppID 不能完成真实微信登录。微信与短信账号不会自动合并，本版本暂不提供手机号绑定；接口失败不会伪造登录成功。</view>
  <button class="secondary" disabled="{{busy}}" bindtap="toggleSms">{{sms ? '收起短信登录' : '使用短信备用登录'}}</button>
</view>
<view class="card" wx:if="{{sms}}"><view class="title">短信备用登录</view>
  <view class="field"><text class="label">手机号</text><input type="number" maxlength="11" value="{{mobile}}" data-field="mobile" bindinput="input" placeholder="请输入手机号" disabled="{{busy || sending}}"/></view>
  <view class="row"><input class="grow" type="number" maxlength="8" value="{{code}}" data-field="code" bindinput="input" placeholder="短信验证码" disabled="{{busy}}"/><button class="secondary small" loading="{{sending}}" disabled="{{cooling > 0 || sending || busy}}" bindtap="sendCode">{{smsLabel}}</button></view>
  <view class="notice" wx:if="{{demoCode}}">后端演示验证码：{{demoCode}}（非真实短信发送证明，请手动填写）</view>
  <button class="primary" loading="{{busy}}" disabled="{{busy || sending}}" bindtap="smsLogin">短信登录 / 注册</button>
</view></view>
