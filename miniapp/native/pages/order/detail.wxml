<view class="page"><view class="notice" wx:if="{{invalid}}">订单ID无效，请从订单列表进入。</view><view class="card" wx:if="{{error}}"><view class="error">{{error}}</view><button bindtap="load" disabled="{{loading || busy}}">重新加载</button></view>
<view class="empty" wx:if="{{loading && !order}}">正在加载订单…</view>
<block wx:if="{{order}}"><view class="card"><view class="row"><view class="title">{{order.statusText}}</view><text>{{order.typeText}}</text></view><view class="muted mono">{{order.orderNo}}</view><view class="line">取：{{order.fromAddress}}</view><view class="line">送：{{order.toAddress}}</view><view class="line">物品：{{order.goodsDesc || '无'}}</view><view class="line" wx:if="{{order.pickupCode}}">取件码：<text class="mono">{{order.pickupCode}}</text><view class="hint">请向承运骑手核对，不要泄露给无关人员。</view></view><view class="row line"><text>订单金额</text><text class="price">¥{{order.feeText}}</text></view><view class="hint">下单时间：{{order.createdText}}</view><button class="secondary" bindtap="track">查看真实配送轨迹</button><button class="secondary" bindtap="load" disabled="{{loading || busy}}">刷新订单状态</button></view>
<view class="card" wx:if="{{order.canPay}}"><view class="notice">MOCK 模拟支付，不是真实微信支付。</view><button class="primary" loading="{{busy}}" disabled="{{busy || loading}}" bindtap="pay">MOCK 模拟支付</button></view>
<view class="card" wx:if="{{order.canCancel}}"><view class="title">取消订单</view><input value="{{cancelReason}}" data-field="cancelReason" bindinput="input" maxlength="200" placeholder="取消原因（选填）" disabled="{{busy}}"/><view class="hint">接单前取消免费；接单后按服务端规则可能计收取消费。退款仅为模拟。</view><button class="danger" disabled="{{busy || loading}}" bindtap="cancel">取消订单</button></view>
<view class="card" wx:if="{{order.canConfirm}}"><view class="title">物品已送达</view><button class="primary" disabled="{{busy || loading}}" loading="{{busy}}" bindtap="confirm">确认收货</button></view>
<view class="card" wx:if="{{order.canReview}}"><view class="title">评价骑手</view><view class="hint" wx:if="{{reviewed}}">本机记录：已提交评价，感谢反馈。</view><block wx:else><picker range="{{stars}}" value="{{starIndex}}" bindchange="starsChange" disabled="{{busy}}"><view class="picker">评分：{{stars[starIndex]}} 星</view></picker><textarea class="field" value="{{content}}" data-field="content" bindinput="input" maxlength="500" placeholder="说说这次服务（选填）" disabled="{{busy}}"/><button class="primary" disabled="{{busy || loading}}" bindtap="review">提交评价</button><view class="hint">一单一评，以服务端记录为准，支持完成后7天内评价。</view></block></view>
<view class="card" wx:if="{{order.canComplain}}"><view class="title">售后与投诉</view><picker range="{{complaintTypes}}" range-key="label" value="{{complaintIndex}}" bindchange="complaintChange" disabled="{{busy}}"><view class="picker">问题类型：{{complaintTypes[complaintIndex].label}}</view></picker><textarea class="field" value="{{complaintDescription}}" data-field="complaintDescription" bindinput="input" maxlength="1000" placeholder="请描述问题与诉求，不要填写密码等敏感信息" disabled="{{busy}}"/><button class="danger" disabled="{{busy || loading}}" bindtap="complaint">提交投诉</button><view class="hint" wx:if="{{ticket}}">{{ticket}}</view></view>
</block></view>
