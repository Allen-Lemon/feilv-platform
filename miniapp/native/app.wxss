page{background:#f4f6f5;color:#25382f;font-size:28rpx;line-height:1.65}view,text,input,textarea,button{box-sizing:border-box} .page{padding:20rpx 24rpx 60rpx}.card{background:#fff;border-radius:20rpx;padding:28rpx;margin-bottom:22rpx;border:1rpx solid #e3eae6}.title{font-size:34rpx;font-weight:700;margin-bottom:18rpx}.subtitle{font-size:30rpx;font-weight:600;margin:20rpx 0 12rpx}.muted,.hint{color:#65766d;font-size:25rpx}.hint{margin:16rpx 0;line-height:1.7}.notice{padding:20rpx;border-radius:12rpx;background:#fff3db;color:#73501a;font-size:25rpx;margin-bottom:20rpx}.error{color:#a52b32}.success{color:#176b52}.primary{background:#176b52;color:white}.danger{background:#fff0f0;color:#a52b32}.secondary{background:#eaf3ee;color:#176b52}button{font-size:28rpx;border-radius:14rpx;margin:14rpx 0;line-height:2.5}button::after{border:0}button[disabled]{opacity:.5}.small{font-size:24rpx;line-height:2.3;padding:0 20rpx;margin:6rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.wrap{flex-wrap:wrap}.grow{flex:1;min-width:0}.field{margin:14rpx 0 22rpx}.label{display:block;color:#4e6257;font-size:25rpx;margin-bottom:8rpx}input,textarea,.picker{background:#f3f6f4;border:1rpx solid #dce5df;border-radius:12rpx;width:100%;padding:18rpx 20rpx;font-size:28rpx}input{height:86rpx}textarea{height:180rpx}.line{padding:12rpx 0;border-bottom:1rpx solid #edf1ef;word-break:break-all}.price{font-size:36rpx;font-weight:700;color:#176b52}.tag{display:inline-block;font-size:23rpx;padding:2rpx 14rpx;border-radius:8rpx;background:#eaf3ee;color:#176b52;margin-left:12rpx}.empty{text-align:center;color:#65766d;padding:60rpx 20rpx}.link{color:#176b52;text-decoration:underline;padding:8rpx 0}.divider{border-bottom:1rpx solid #e3eae6;margin:22rpx 0}.hero{background:#176b52;color:#fff;border-radius:22rpx;padding:40rpx 30rpx;margin-bottom:24rpx}.hero .title{font-size:46rpx}.entry{padding:24rpx 0;border-bottom:1rpx solid #e3eae6}.actions{display:flex;gap:12rpx;flex-wrap:wrap;margin-top:16rpx}.actions button{flex:1;min-width:160rpx}.mono{font-family:monospace;word-break:break-all}.map{width:100%;height:650rpx}.item{padding:22rpx 0;border-bottom:1rpx solid #e3eae6}
