.rider-head{display:flex;justify-content:space-between;align-items:center}.name{font-size:32rpx;font-weight:700}.meta{font-size:24rpx;color:#909399;margin-top:6rpx}.mode{background:#f5f6f8;color:#909399;font-size:26rpx;border-radius:40rpx;height:72rpx;line-height:72rpx;padding:0 30rpx}.mode.on{background:#fff2e0;color:#ff7d00}.sec-title{font-weight:600;margin-bottom:18rpx}.grab{display:flex;justify-content:space-between;align-items:center;padding:18rpx 0;border-bottom:1rpx solid #f2f3f5}.grab-info{flex:1;display:flex;flex-direction:column;gap:6rpx}.type{color:#ff7d00;font-size:26rpx;font-weight:600}.addr{font-size:26rpx;color:#303133}.grab-btn{background:#ff7d00;color:#fff;font-size:24rpx;border-radius:30rpx}.mine{padding:18rpx 0;border-bottom:1rpx solid #f2f3f5}.acts{display:flex;gap:12rpx;margin-top:12rpx;flex-wrap:wrap}.act{background:#f5f6f8;color:#606266;font-size:22rpx;border-radius:26rpx}.act.main{background:#ff7d00;color:#fff}.empty{color:#c0c4cc;font-size:24rpx;text-align:center;padding:30rpx 0}
