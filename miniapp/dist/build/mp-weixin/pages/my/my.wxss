.user-row{display:flex;align-items:center;gap:24rpx}.avatar{width:100rpx;height:100rpx;border-radius:50%;background:#ff7d00;color:#fff;display:flex;align-items:center;justify-content:center;font-size:44rpx}.nick{font-size:32rpx;font-weight:600}.mobile{font-size:24rpx;color:#909399;margin-top:6rpx}.sec-title{font-weight:600;margin-bottom:18rpx}.input{background:#f5f6f8;padding:20rpx 24rpx;border-radius:12rpx;margin-bottom:16rpx;font-size:28rpx}.row{display:flex;align-items:center}.code{flex:1;margin-right:16rpx}.mini{background:#fff2e0;color:#ff7d00;font-size:24rpx;border-radius:12rpx;height:76rpx;line-height:76rpx;padding:0 20rpx}.hint{font-size:22rpx;color:#c0c4cc;margin-top:16rpx}.btn-out{background:#fff;color:#f56c6c;border:1rpx solid #f56c6c;border-radius:44rpx;font-size:28rpx}
