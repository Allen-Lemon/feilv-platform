<view><view wx:if="{{a}}" class="card"><view class="user-row"><view class="avatar">{{b}}</view><view><view class="nick">{{c}}</view><view class="mobile">{{d}}（已脱敏）</view></view></view></view><view wx:else class="card"><button class="btn-primary" bindtap="{{e}}">登录 / 注册</button></view><view wx:if="{{f}}" class="card"><view class="sec-title">成为飞毛腿骑手</view><input type="number" maxlength="11" placeholder="手机号" class="input" value="{{g}}" bindinput="{{h}}"/><input placeholder="真实姓名" class="input" value="{{i}}" bindinput="{{j}}"/><input placeholder="车牌号（选填）" class="input" value="{{k}}" bindinput="{{l}}"/><view class="row"><input type="number" maxlength="6" placeholder="验证码" class="input code" value="{{m}}" bindinput="{{n}}"/><button class="mini" bindtap="{{o}}">获取验证码</button></view><button class="btn-primary" bindtap="{{p}}">提交入驻</button><view class="hint">演示模式验证码自动回填；生产需健康证明、意外险与职业伤害保障</view></view><view wx:else class="card"><view class="sec-title">骑手服务</view><button class="btn-primary" bindtap="{{q}}">进入骑手工作台</button></view><view wx:if="{{r}}" class="card"><button class="btn-primary" bindtap="{{s}}">地址簿管理</button><button class="btn-out" bindtap="{{t}}">退出登录</button></view></view>