<view><view class="card"><view class="sec-title">取件信息</view><input placeholder="取件人姓名" class="input" value="{{a}}" bindinput="{{b}}"/><input type="number" maxlength="11" placeholder="取件人电话" class="input" value="{{c}}" bindinput="{{d}}"/><input placeholder="取件地址（生产为地图选点）" class="input" value="{{e}}" bindinput="{{f}}"/><view class="sec-title">送达信息</view><input placeholder="收件人姓名" class="input" value="{{g}}" bindinput="{{h}}"/><input type="number" maxlength="11" placeholder="收件人电话" class="input" value="{{i}}" bindinput="{{j}}"/><input placeholder="送达地址（生产为地图选点）" class="input" value="{{k}}" bindinput="{{l}}"/><view class="sec-title">物品与要求</view><input placeholder="物品名称（如：文件、蛋糕、药品）" class="input" value="{{m}}" bindinput="{{n}}"/><button class="photo-btn" bindtap="{{p}}">{{o}}</button><picker range="{{r}}" bindchange="{{s}}"><view class="picker">{{q}}</view></picker><input type="digit" placeholder="预估距离（公里，生产由地图路线计算）" class="input" value="{{t}}" bindinput="{{v}}"/><block wx:if="{{r0}}"><textarea placeholder="备注（如：放门口、轻拿轻放）" class="textarea" value="{{w}}" bindinput="{{x}}"/></block></view><view wx:if="{{y}}" class="card"><view class="sec-title">费用预估（生产实时计算）</view><view wx:for="{{z}}" wx:for-item="it" wx:key="c" class="fee"><text>{{it.a}}</text><text>￥{{it.b}}</text></view><view class="fee total"><text>预计费用</text><text class="price">￥{{A}}</text></view><button class="btn-primary" style="margin-top:24rpx" bindtap="{{B}}">下一步，确认订单</button></view><view wx:else class="card"><button class="btn-primary" bindtap="{{C}}">计算费用</button></view></view>