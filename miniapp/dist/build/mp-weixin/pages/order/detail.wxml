<view><view class="card"><view class="status-bar"><text class="big">{{a}}</text><text class="no">{{b}}</text></view><view class="line"><text>取件</text><text>{{c}}</text></view><view class="line"><text>送达</text><text>{{d}}</text></view><view class="line"><text>物品</text><text>{{e}}</text></view><view class="line"><text>费用</text><text class="fee">￥{{f}}</text></view><view wx:if="{{g}}" class="line"><text>骑手轨迹</text><text class="track">{{h}}个轨迹点（生产用地图展示，刷新≤5秒）</text></view></view><view wx:if="{{i}}" class="card"><button class="btn-primary" bindtap="{{j}}">确认收货</button><view class="hint">15分钟未确认将默认完成并触发分账</view></view><view wx:if="{{k}}" class="card"><view class="sec-title">评价骑手</view><view class="stars"><text wx:for="{{l}}" wx:for-item="s" wx:key="a" class="{{['star', s.b && 'on']}}" bindtap="{{s.c}}">★</text></view><block wx:if="{{r0}}"><textarea placeholder="说说这次服务（选填）" class="textarea" value="{{m}}" bindinput="{{n}}"/></block><button class="btn-primary" style="margin-top:20rpx" bindtap="{{o}}">提交评价</button></view><view wx:if="{{p}}" class="card"><view class="sec-title">售后与投诉</view><picker range="{{r}}" bindchange="{{s}}"><view class="picker">{{q}}</view></picker><block wx:if="{{r0}}"><textarea class="textarea" placeholder="请描述问题（丢件、损坏、超时等）" value="{{t}}" bindinput="{{v}}"/></block><button class="btn-primary" bindtap="{{w}}">提交投诉</button></view></view>