<view><view wx:for="{{a}}" wx:for-item="a" wx:key="h" class="card"><view class="top"><text class="name">{{a.a}}</text><text>{{a.b}}</text><text wx:if="{{a.c}}" class="tag">默认</text></view><view class="addr">{{a.d}} {{a.e}}</view><view class="actions"><button size="mini" bindtap="{{a.f}}">编辑</button><button size="mini" type="warn" bindtap="{{a.g}}">删除</button></view></view><view class="card"><view class="title">{{b}}</view><input placeholder="联系人" class="input" value="{{c}}" bindinput="{{d}}"/><input placeholder="联系电话" class="input" value="{{e}}" bindinput="{{f}}"/><input placeholder="地点名称（选填）" class="input" value="{{g}}" bindinput="{{h}}"/><input placeholder="详细地址" class="input" value="{{i}}" bindinput="{{j}}"/><switch checked="{{k}}" bindchange="{{l}}"/> <text>设为默认</text><button class="btn-primary" bindtap="{{m}}">保存地址</button></view></view>