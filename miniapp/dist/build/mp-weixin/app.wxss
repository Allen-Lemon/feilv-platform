page{background:#f5f6f8;font-size:28rpx;color:#303133}.card{background:#fff;border-radius:16rpx;padding:24rpx;margin:20rpx}.btn-primary{background:#ff7d00;color:#fff;border-radius:44rpx;font-size:30rpx}.btn-primary:after{border:none}.tag{display:inline-block;padding:4rpx 16rpx;border-radius:8rpx;font-size:22rpx;color:#ff7d00;background:#fff2e0}
