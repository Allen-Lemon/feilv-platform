{
  "name": "feilv-miniapp",
  "version": "1.0.0",
  "description": "飞毛腿微信原生小程序；旧 uni-app 源码与依赖仅用于 legacy 脚本，不参与原生运行",
  "scripts": {
    "check": "node scripts/check-native.cjs",
    "check:wechat": "node scripts/compile-wechat.cjs",
    "test": "node scripts/test-native.cjs",
    "build": "npm run check && npm test",
    "legacy:dev:mp-weixin": "uni -p mp-weixin",
    "legacy:build:mp-weixin": "uni build -p mp-weixin"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-4020920240930001",
    "@dcloudio/uni-app-plus": "3.0.0-4020920240930001",
    "@dcloudio/uni-components": "3.0.0-4020920240930001",
    "@dcloudio/uni-h5": "3.0.0-4020920240930001",
    "@dcloudio/uni-mp-weixin": "3.0.0-4020920240930001",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@dcloudio/uni-automator": "3.0.0-4020920240930001",
    "@dcloudio/vite-plugin-uni": "3.0.0-4020920240930001"
  }
}
