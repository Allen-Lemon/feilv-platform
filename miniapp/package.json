{
  "name": "feilv-miniapp",
  "version": "1.0.0",
  "private": true,
  "description": "飞毛腿微信原生小程序，使用 App/Page、WXML、WXSS；无第三方运行时或构建依赖",
  "engines": { "node": ">=18" },
  "scripts": {
    "check": "node scripts/check-native.cjs",
    "check:wechat": "node scripts/compile-wechat.cjs",
    "check:release": "npm run build && node scripts/check-release.cjs",
    "test": "node scripts/test-native.cjs",
    "build": "npm run check && npm test"
  }
}
