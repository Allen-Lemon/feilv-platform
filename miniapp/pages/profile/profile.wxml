<import src="../../templates/manual-phone.wxml"/>
<view class="page profile-page">
  <view class="page-head"><view class="eyebrow">我的账号 · 资料完善</view><view class="title">{{phoneOnly ? '管理绑定手机号' : fromLogin ? '欢迎加入飞毛腿' : '编辑账号资料'}}</view><view class="page-desc">{{phoneOnly ? '可使用微信授权，或手动填写手机号并通过短信验证。只展示脱敏号码，不自动合并其他账号。' : '头像和昵称由您主动选择或填写，不会自动获取。下单前需保存非空昵称并绑定手机号；头像可保留默认，暂未完善也可返回浏览。'}}</view></view>
  <view class="loading-note" wx:if="{{loading}}">正在读取账号资料与授权状态…</view>
  <view class="card" wx:if="{{error}}"><view class="error">{{error}}</view><button class="secondary" disabled="{{loading || saving || uploading || binding || phoneSending || phoneOptionsLoading || checkingPrivacy || openingPrivacy}}" bindtap="load">重新读取资料与授权状态</button></view>
  <view class="card" wx:if="{{loaded && !phoneOnly}}">
    <view class="section-title">头像 <text class="optional">可保留默认</text></view>
    <image wx:if="{{avatarDraft || avatarUrl}}" class="profile-avatar" src="{{avatarDraft || avatarUrl}}" mode="aspectFill"/>
    <view wx:else class="profile-avatar avatar-default">头像</view>
    <button wx:if="{{avatarSupported}}" class="secondary" open-type="chooseAvatar" bindtap="prepareAvatar" bindchooseavatar="chooseAvatar" disabled="{{loading || saving || uploading || binding || phoneSending || phoneOptionsLoading || checkingPrivacy || openingPrivacy}}">主动选择头像</button>
    <view class="hint" wx:else>当前微信版本不支持头像选择，请升级微信；可继续使用默认头像。</view>
    <view class="hint">仅支持5MB以内 JPEG / PNG。选择后点击保存才会上传；头像为公开展示图片，请勿上传含证件、手机号等私密信息的图片。</view>
    <button wx:if="{{avatarDraft}}" class="secondary" bindtap="saveAvatar" loading="{{uploading}}" disabled="{{loading || saving || uploading || binding || phoneSending || phoneOptionsLoading || checkingPrivacy || openingPrivacy}}">保存头像</button>
    <button wx:if="{{avatarDraft}}" class="text-button" bindtap="discardAvatar" disabled="{{loading || saving || uploading || binding || phoneSending || phoneOptionsLoading || checkingPrivacy || openingPrivacy}}">不保存，保留原头像</button>
  </view>
  <view class="card" wx:if="{{loaded && !phoneOnly}}">
    <view class="section-title">平台昵称 <text class="optional">下单必填</text></view>
    <view class="field"><label class="label" for="profile-nickname">你希望大家如何称呼你</label><input id="profile-nickname" type="nickname" maxlength="64" value="{{nickname}}" bindinput="input" bindblur="input" disabled="{{loading || saving || uploading || binding || phoneSending || phoneOptionsLoading || checkingPrivacy || openingPrivacy}}" placeholder="主动填写或选择昵称后保存"/></view>
    <view class="hint">保存时去除首尾空格，限1至32个字符，不含控制字符。微信默认昵称不代表已完善，只有点击保存才会更新昵称。</view>
    <button class="secondary" loading="{{saving}}" disabled="{{loading || saving || uploading || binding || phoneSending || phoneOptionsLoading || checkingPrivacy || openingPrivacy}}" bindtap="save">保存昵称</button>
  </view>
  <view class="card" wx:if="{{loaded}}">
    <view class="section-title">绑定手机号 <text class="optional">下单必填</text></view>
    <view class="phone-status" wx:if="{{mobileBound}}"><view class="success">当前绑定手机号</view><view class="hint">{{mobile || '号码已脱敏保护'}}</view><button wx:if="{{!changingPhone}}" class="secondary" bindtap="startPhoneChange" disabled="{{loading || saving || uploading || binding || phoneSending || phoneOptionsLoading || checkingPrivacy || openingPrivacy}}">更换手机号</button></view>
    <block wx:if="{{!mobileBound || changingPhone}}">
      <view class="section-title" wx:if="{{changingPhone}}">验证新手机号</view>
      <view class="hint">{{changingPhone ? '通过微信新号授权或新号短信验证码更换。成功前原号码不变；用户ID、钱包、订单与角色不变，已占用号码不合并。' : '选择微信授权快速绑定，或手动填写并通过短信验证。未绑定可浏览，但不能下单。'}}</view>
      <view class="phone-error error" wx:if="{{phoneError}}">{{phoneError}}</view>
      <view class="notice" wx:if="{{!phoneOnly && nickname !== savedNickname}}">昵称修改尚未保存。绑定手机号不会自动保存昵称，请单独点击“保存昵称”。</view>
      <block wx:if="{{!manualPhone}}">
      <view class="hint" wx:if="{{!phoneSupported}}">当前微信版本不支持安全绑定手机号，请升级微信后重试；可返回浏览。</view>
      <block wx:elif="{{privacyNeeded}}">
        <button class="text-button privacy-link" bindtap="openPrivacy" disabled="{{loading || saving || uploading || binding || phoneSending || phoneOptionsLoading || checkingPrivacy || openingPrivacy}}">查看{{privacyTitle}}</button>
        <button wx:if="{{privacyGateSupported}}" id="agree-profile-privacy" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="agreePrivacy" class="secondary" loading="{{checkingPrivacy}}" disabled="{{loading || saving || uploading || binding || phoneSending || phoneOptionsLoading || checkingPrivacy || openingPrivacy}}">同意隐私指引，继续手机号授权</button>
        <view class="hint" wx:else>请升级微信以完成隐私授权，也可返回浏览。</view>
      </block>
      <button wx:elif="{{privacyReady}}" class="primary" open-type="getPhoneNumber" bindtap="preparePhone" bindgetphonenumber="bindPhone" loading="{{binding}}" disabled="{{loading || saving || uploading || binding || phoneSending || phoneOptionsLoading || checkingPrivacy || openingPrivacy}}">{{binding ? '正在处理手机号…' : changingPhone ? '授权微信新手机号并更换' : '授权并绑定微信手机号'}}</button>
      <view class="hint" wx:else>隐私状态尚未确认，可重试读取或返回浏览。</view>
      </block>
      <template wx:if="{{manualPhone}}" is="manualPhoneForm" data="{{changingPhone, manualMobile, manualCode, phoneSending, phoneCooling, phoneSmsLabel, phoneSmsMock, phoneDemoCode, phoneDevelopment, phoneOptionsLoading, phoneOptionsError, phoneModeMessage, phoneBackend, binding, manualDisabled: loading || saving || uploading || binding || phoneSending || phoneOptionsLoading || checkingPrivacy || openingPrivacy}}"/>
      <button class="phone-method-toggle" bindtap="togglePhoneMethod" disabled="{{loading || saving || uploading || binding || phoneSending || phoneOptionsLoading || checkingPrivacy || openingPrivacy}}">{{manualPhone ? '改用微信授权' : changingPhone ? '填写新手机号并短信验证 →' : '手动填写手机号并短信验证 →'}}</button>
      <button wx:if="{{changingPhone}}" class="text-button" bindtap="cancelPhoneChange" disabled="{{loading || saving || uploading || binding || phoneSending || phoneOptionsLoading || checkingPrivacy || openingPrivacy}}">取消修改，保留当前手机号</button>
    </block>
    <view class="hint">绑定信息不会自动填入订单联系人电话，也不会自动合并短信账号。若号码已用于其他账号，请按服务端提示处理。</view>
  </view>
  <view class="profile-actions"><button class="primary" bindtap="complete" disabled="{{!loaded || loading || saving || uploading || binding || phoneSending || phoneOptionsLoading || checkingPrivacy || openingPrivacy}}">{{phoneOnly ? '完成，返回我的' : '完成并继续'}}</button><button class="text-button" bindtap="leave" disabled="{{saving || uploading || binding || phoneSending}}">返回浏览（未保存修改不生效）</button></view>
  <view class="footer-note">可随时从“我的 → 账号资料”回来修改。下单时会重新核验服务端手机号和昵称状态。</view>
</view>
