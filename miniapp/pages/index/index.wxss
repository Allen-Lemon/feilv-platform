page { background: #F7F8FA; }
.home-page { max-width: 960rpx; margin: 0 auto; }
.home-brand { display: flex; align-items: center; margin: 0 4rpx 28rpx; }
.brand-mark { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 72rpx; height: 72rpx; margin-right: 16rpx; border-radius: 23rpx; background: #C94320; color: #FFFFFF; font-size: 38rpx; font-weight: 700; }
.brand-lockup { flex: 1; min-width: 0; }
.brand-name { color: #202939; font-size: 32rpx; font-weight: 700; line-height: 1.4; }
.brand-subtitle { margin-top: 2rpx; color: #667085; font-size: 22rpx; }
.brand-city { display: flex; align-items: center; flex-shrink: 0; margin-left: 14rpx; padding: 12rpx 18rpx; border: 1rpx solid #E4E7EC; border-radius: 999rpx; background: #FFFFFF; color: #475467; font-size: 23rpx; }
.city-dot { width: 9rpx; height: 9rpx; margin-right: 10rpx; border-radius: 50%; background: #C94320; }
.home-hero { position: relative; overflow: hidden; padding: 30rpx; border: 1rpx solid #F8D9C7; border-radius: 30rpx; background: #FFF0E5; }
.hero-content { position: relative; z-index: 1; max-width: 78%; }
.hero-title { margin: 12rpx 0 16rpx; color: #352B26; font-size: 41rpx; font-weight: 700; line-height: 1.4; }
.hero-desc { color: #8F4931; font-size: 24rpx; line-height: 1.7; }
.hero-orbit { position: absolute; right: -128rpx; bottom: -156rpx; width: 360rpx; height: 360rpx; border: 46rpx solid #F4C6AC; border-radius: 50%; opacity: 0.6; }
.hero-emblem { position: absolute; right: 28rpx; top: 62rpx; color: #C94320; font-size: 88rpx; font-weight: 700; font-style: italic; line-height: 1; opacity: 0.14; transform: rotate(-8deg); }
.hero-emblem text { display: block; margin-left: 54rpx; font-size: 50rpx; }
.home-section { margin: 30rpx 4rpx 16rpx; }
.home-section .section-title { margin-right: 12rpx; color: #202939; font-size: 30rpx; }
.home-section .section-note { font-size: 22rpx; }
.service-list { display: flex; flex-wrap: wrap; justify-content: space-between; margin-bottom: 22rpx; }
.home-page .service-entry { display: flex; align-items: flex-start; flex-direction: column; width: 48.5%; margin: 16rpx 0 0; padding: 24rpx; border: 1rpx solid #EAECF0; border-radius: 26rpx; background: #FFFFFF; color: #202939; text-align: left; }
.service-list .service-entry:first-child { margin-top: 0; }
.home-page .service-SEND { align-items: center; flex-direction: row; width: 100%; padding: 26rpx; border-color: #F5D4C1; background: #FFF8F2; }
.service-icon { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 72rpx; height: 72rpx; margin-bottom: 18rpx; border-radius: 23rpx; background: #FFF0E8; color: #AA381B; font-size: 31rpx; font-weight: 700; }
.service-SEND .service-icon { width: 96rpx; height: 96rpx; margin: 0 24rpx 0 0; border-radius: 28rpx; background: #C94320; color: #FFFFFF; font-size: 42rpx; }
.service-BUY .service-icon { background: #EEF4FF; color: #344E86; }
.service-ERRAND .service-icon { background: #EDF7F2; color: #176B52; }
.service-copy { flex: 1; min-width: 0; }
.service-name { font-size: 31rpx; font-weight: 700; line-height: 1.45; }
.service-desc { min-height: 74rpx; margin-top: 8rpx; color: #667085; font-size: 23rpx; font-weight: 400; line-height: 1.6; word-wrap: break-word; }
.service-SEND .service-desc { min-height: 0; }
.service-cta { margin-top: 18rpx; color: #AA381B; font-size: 23rpx; font-weight: 600; line-height: 1.6; }
.service-cta text { margin-left: 8rpx; }
.home-shortcuts { display: flex; justify-content: space-between; margin-bottom: 22rpx; }
.home-shortcuts button { justify-content: flex-start; width: 48.5%; margin: 0; padding: 22rpx 16rpx; border: 1rpx solid #EAECF0; border-radius: 23rpx; background: #FFFFFF; text-align: left; }
.quick-icon { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 52rpx; height: 52rpx; margin-right: 12rpx; border-radius: 16rpx; background: #FFF0E8; color: #AA381B; font-size: 24rpx; }
.quick-icon.address-icon { background: #EEF4FF; color: #344E86; }
.quick-copy { flex: 1; min-width: 0; }
.quick-title { color: #202939; font-size: 25rpx; font-weight: 600; }
.quick-caption { margin-top: 3rpx; color: #667085; font-size: 21rpx; font-weight: 400; }
.home-shortcuts .chevron { width: 10rpx; height: 10rpx; margin-left: 8rpx; margin-right: 0; }
.home-demo { margin-bottom: 22rpx; font-size: 23rpx; }
.home-guide { padding: 24rpx; }
.home-guide .section-title { font-size: 28rpx; }
.home-guide .section-note { font-size: 22rpx; }
.guide-row { display: flex; margin-top: 14rpx; color: #667085; font-size: 23rpx; line-height: 1.75; }
.guide-dot { flex-shrink: 0; width: 7rpx; height: 7rpx; margin: 16rpx 14rpx 0 0; border-radius: 50%; background: #C94320; }
.home-links { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; margin-top: 20rpx; padding-top: 8rpx; border-top: 1rpx solid #F0F2F5; }
.connection-caption { color: #667085; font-size: 22rpx; }
.home-links .text-button { padding: 16rpx 0 16rpx 12rpx; font-size: 23rpx; }
.home-footer { padding: 12rpx 0 0; color: #667085; font-size: 22rpx; text-align: center; }
@media (max-width: 350px) {
  .brand-city { padding: 10rpx 14rpx; font-size: 21rpx; }
  .hero-content { max-width: 88%; }
  .hero-title { font-size: 36rpx; }
  .hero-emblem { right: 12rpx; opacity: 0.08; }
  .home-page .service-entry { padding: 20rpx; }
  .service-SEND .service-icon { width: 80rpx; height: 80rpx; margin-right: 18rpx; }
  .service-name { font-size: 28rpx; }
  .home-shortcuts button { flex-direction: column; align-items: flex-start; padding: 20rpx; }
  .home-shortcuts .quick-icon { margin-bottom: 12rpx; }
  .home-shortcuts .chevron { display: none; }
}
