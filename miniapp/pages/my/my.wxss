page { background: #F7F8FA; }
.account-page { max-width: 960rpx; margin: 0 auto; }
.account-head { margin-bottom: 26rpx; }
.account-head .title { font-size: 38rpx; }
.account-head .page-desc { font-size: 24rpx; }
.account-card { overflow: hidden; padding: 28rpx 26rpx 0; border-color: #F0DDD0; background: linear-gradient(135deg, #FFF3E9 0%, #FFFFFF 80%); }
.account-identity { display: flex; align-items: center; padding-bottom: 26rpx; }
.account-avatar { display: block; flex-shrink: 0; width: 112rpx; height: 112rpx; margin-right: 24rpx; border: 5rpx solid #FFFFFF; border-radius: 34rpx; background: #FFE4D3; }
.account-avatar-default { display: flex; align-items: center; justify-content: center; color: #AA381B; font-size: 46rpx; font-weight: 700; }
.account-info { flex: 1; min-width: 0; }
.account-name { color: #202939; font-size: 34rpx; font-weight: 700; line-height: 1.45; word-break: break-all; }
.account-role { display: inline-block; margin-top: 8rpx; padding: 3rpx 12rpx; border-radius: 8rpx; background: #FFF0E8; color: #AA381B; font-size: 21rpx; }
.account-mobile { margin-top: 8rpx; color: #667085; font-size: 23rpx; line-height: 1.65; word-wrap: break-word; }
.account-phone-bind { margin: 0 0 22rpx; padding: 20rpx 18rpx; background: #C94320; color: #FFFFFF; font-size: 25rpx; }
.account-phone-bind[disabled] { background: #EAECF0; color: #667085; }
.account-profile-link { justify-content: flex-start; margin: 0; padding: 22rpx 0; border-top: 1rpx solid #F0E5DC; border-radius: 0; background: transparent; text-align: left; }
.profile-link-title { font-size: 27rpx; font-weight: 600; }
.profile-link-caption { margin-top: 3rpx; color: #667085; font-size: 22rpx; font-weight: 400; }
.account-error { margin-bottom: 18rpx; padding: 16rpx 18rpx; border-radius: 14rpx; background: #FEF3F2; font-size: 24rpx; word-wrap: break-word; }
.account-error .retry-button { justify-content: flex-start; width: auto; margin-top: 4rpx; padding: 8rpx 0; font-size: 24rpx; }
.guest-card { padding-bottom: 26rpx; }
.guest-card .account-identity { padding-bottom: 4rpx; }
.account-section-title { margin: 28rpx 4rpx 14rpx; color: #475467; font-size: 25rpx; font-weight: 600; }
.account-menu { margin-bottom: 20rpx; }
.account-menu .menu-button { padding: 23rpx 0; }
.account-menu .menu-icon { width: 64rpx; height: 64rpx; margin-right: 18rpx; border-radius: 20rpx; }
.account-menu .address-icon { background: #EEF4FF; color: #344E86; }
.account-menu .rider-icon { background: #EDF7F2; color: #176B52; }
.account-menu .neutral-icon { background: #F2F4F7; color: #475467; }
.menu-title { font-size: 28rpx; font-weight: 600; }
.account-menu .menu-caption { margin-top: 4rpx; font-size: 23rpx; line-height: 1.6; }
.account-tip { margin: 24rpx 8rpx; color: #667085; font-size: 23rpx; line-height: 1.8; }
.account-logout { margin: 24rpx 0; border: 1rpx solid #EAECF0; background: #FFFFFF; color: #B42318; font-size: 27rpx; }
.account-profile-link[disabled], .account-logout[disabled] { background: #EAECF0; color: #667085; }
.account-demo { margin: 28rpx 8rpx 0; padding-top: 20rpx; border-top: 1rpx solid #E4E7EC; color: #667085; font-size: 22rpx; line-height: 1.8; }
.demo-label { display: block; margin-bottom: 6rpx; color: #475467; font-weight: 600; }
@media (max-width: 350px) {
  .account-head .title { font-size: 34rpx; }
  .account-avatar { width: 96rpx; height: 96rpx; margin-right: 18rpx; border-radius: 28rpx; }
  .account-name { font-size: 30rpx; }
  .account-card { padding-right: 22rpx; padding-left: 22rpx; }
}
