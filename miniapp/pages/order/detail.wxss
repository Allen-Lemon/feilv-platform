.detail-page {
  max-width: 960rpx;
  margin: 0 auto;
  padding: 24rpx 24rpx 40rpx;
  padding-right: calc(24rpx + env(safe-area-inset-right));
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  padding-left: calc(24rpx + env(safe-area-inset-left));
  background: #F7F8FA;
}

.task-content { white-space: pre-wrap; word-break: break-all; line-height: 1.7; }
.task-tags { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 18rpx; }
.complaint-record { margin-top: 24rpx; padding-top: 24rpx; border-top: 1rpx solid #EAECF0; }

.detail-page .card {
  min-width: 0;
  margin-bottom: 20rpx;
  padding: 28rpx;
  border: 1rpx solid #EAECF0;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: none;
}

.detail-page button {
  min-width: 44px;
  min-height: 44px;
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  font-size: 27rpx;
}

.detail-page .primary {
  background: #C94320;
  color: #FFFFFF;
  box-shadow: none;
}

.detail-page .service-header {
  padding: 30rpx 28rpx 0;
  border-top: 6rpx solid #C94320;
}

.detail-page .service-state-DELIVERING,
.detail-page .service-state-ACCEPTED,
.detail-page .service-state-PICKING {
  border-top-color: #344E86;
}

.service-state-DELIVERING .status-dot,
.service-state-ACCEPTED .status-dot,
.service-state-PICKING .status-dot {
  background: #344E86;
}

.detail-page .service-state-DELIVERED,
.detail-page .service-state-FINISHED {
  border-top-color: #176B52;
}

.service-state-DELIVERED .status-dot,
.service-state-FINISHED .status-dot {
  background: #176B52;
}

.detail-page .service-state-CANCELED {
  border-top-color: #667085;
}

.service-state-CANCELED .status-dot {
  background: #667085;
}

.header-topline,
.status-caption,
.pickup-topline,
.amount-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-width: 0;
}

.header-topline {
  flex-wrap: wrap;
}

.status-caption {
  justify-content: flex-start;
  margin: 0 16rpx 10rpx 0;
  color: #667085;
  font-size: 24rpx;
}

.status-dot {
  flex-shrink: 0;
  width: 12rpx;
  height: 12rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: #C94320;
}

.service-type {
  max-width: 100%;
  margin-bottom: 10rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: #FFF0E8;
  color: #AA381B;
  font-size: 23rpx;
  font-weight: 600;
  word-break: break-all;
}

.service-status {
  margin-top: 8rpx;
  color: #202939;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.3;
  word-break: break-all;
}

.status-refreshing {
  margin-top: 10rpx;
  color: #667085;
  font-size: 23rpx;
}

.status-description {
  margin-top: 12rpx;
  color: #667085;
  font-size: 25rpx;
  line-height: 1.65;
  word-wrap: break-word;
}

.status-tools {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
  border-top: 1rpx solid #F0F2F5;
}

.detail-page .quiet-button {
  flex: 1;
  width: auto;
  min-width: 44px;
  margin: 0;
  padding: 18rpx 8rpx;
  border-radius: 0;
  background: transparent;
  color: #AA381B;
  font-size: 25rpx;
  box-shadow: none;
}

.quiet-button + .quiet-button {
  border-left: 1rpx solid #F0F2F5;
}

.panel-title {
  margin-bottom: 20rpx;
  color: #202939;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.45;
}

.panel-description {
  color: #667085;
  font-size: 25rpx;
  line-height: 1.65;
  word-wrap: break-word;
}

.route-node {
  position: relative;
  display: flex;
  align-items: flex-start;
  min-width: 0;
}

.route-origin {
  padding-bottom: 32rpx;
}

.route-origin::before {
  position: absolute;
  top: 48rpx;
  bottom: 6rpx;
  left: 21rpx;
  width: 0;
  border-left: 2rpx dashed #E4E7EC;
  content: "";
}

.route-marker {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  margin-right: 20rpx;
  border-radius: 14rpx;
  background: #FFF0E8;
  color: #AA381B;
  font-size: 23rpx;
  font-weight: 600;
}

.destination-marker {
  background: #EDF0F5;
  color: #344054;
}

.route-content {
  flex: 1;
  min-width: 0;
}

.route-label {
  margin-bottom: 6rpx;
  color: #667085;
  font-size: 23rpx;
}

.address-text {
  color: #202939;
  font-size: 29rpx;
  font-weight: 500;
  line-height: 1.6;
  word-break: break-all;
}

.info-row {
  display: flex;
  align-items: flex-start;
  min-width: 0;
  padding: 10rpx 0;
  font-size: 26rpx;
  line-height: 1.65;
}

.info-label {
  flex-shrink: 0;
  width: 152rpx;
  padding-right: 18rpx;
  color: #667085;
}

.info-value {
  flex: 1;
  min-width: 0;
  color: #344054;
  word-break: break-all;
}

.pickup-panel {
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #F7F8FA;
}

.pickup-topline {
  flex-wrap: wrap;
}

.pickup-label {
  margin-right: 20rpx;
  color: #344054;
  font-size: 25rpx;
}

.pickup-code {
  min-width: 0;
  max-width: 100%;
  color: #C94320;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.4;
}

.privacy-note {
  margin-top: 10rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.65;
  word-wrap: break-word;
}

.amount-row {
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}

.amount-label {
  margin: 8rpx 20rpx 8rpx 0;
  color: #344054;
  font-size: 26rpx;
}

.order-amount {
  min-width: 0;
  max-width: 100%;
  color: #C94320;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.3;
  word-break: break-all;
}

.amount-currency {
  margin-right: 4rpx;
  font-size: 26rpx;
}

.order-metadata {
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F2F5;
}

.detail-page .primary-panel {
  border-color: #F2D5CA;
}

.payment-notice {
  display: flex;
  align-items: flex-start;
  padding: 18rpx;
  border-radius: 14rpx;
  background: #FFF0E8;
  color: #944025;
  font-size: 24rpx;
  line-height: 1.65;
}

.notice-content {
  flex: 1;
  min-width: 0;
  word-wrap: break-word;
}

.form-field {
  margin: 20rpx 0;
}

.form-label {
  margin-bottom: 12rpx;
  color: #344054;
  font-size: 25rpx;
  font-weight: 500;
}

.selection-row {
  min-height: 44px;
  font-size: 26rpx;
}

.selection-row > text:first-child {
  flex: 1;
  min-width: 0;
  word-break: break-all;
}

.selection-hint {
  flex-shrink: 0;
  margin-left: 16rpx;
  color: #667085;
  font-size: 23rpx;
}

.detail-page .feedback-input {
  height: 176rpx;
  min-height: 88px;
  font-size: 26rpx;
}

.form-note {
  color: #667085;
  font-size: 24rpx;
  line-height: 1.7;
  word-wrap: break-word;
}

.detail-page .outline-button {
  border: 1rpx solid #D0D5DD;
  background: #FFFFFF;
  color: #344054;
  box-shadow: none;
}

.detail-page .outline-danger {
  border: 1rpx solid #F3C8C3;
  background: #FFFFFF;
  color: #B42318;
  box-shadow: none;
}

.feedback-result {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background: #F7F8FA;
  color: #344054;
  font-size: 25rpx;
  line-height: 1.7;
  word-break: break-all;
}

.error-message {
  font-size: 26rpx;
  line-height: 1.7;
}

.detail-page button[disabled] {
  border-color: #EAECF0;
  background: #EAECF0;
  color: #667085;
  box-shadow: none;
}

@media (max-width: 350px) {
  .detail-page .card {
    padding: 24rpx;
  }

  .detail-page .service-header {
    padding-bottom: 0;
  }

  .service-status {
    font-size: 40rpx;
  }

  .info-label {
    width: 138rpx;
  }

  .route-marker {
    margin-right: 16rpx;
  }
}
