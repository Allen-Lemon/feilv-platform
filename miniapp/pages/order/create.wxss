page { background: #F7F8FA; }
.create-page { max-width: 960rpx; margin: 0 auto; }
.create-heading .title { font-size: 40rpx; }
.create-heading .page-desc { font-size: 25rpx; line-height: 1.7; }
.draft-restored { margin-bottom: 20rpx; padding: 16rpx 20rpx; border-radius: 16rpx; background: #EDF7F2; color: #176B52; font-size: 23rpx; line-height: 1.7; }
.address-error .small { margin-top: 14rpx; }
.create-page .card { padding: 26rpx; border-radius: 26rpx; }
.create-page .section-head { margin-bottom: 20rpx; }
.create-page .section-title { display: flex; align-items: center; font-size: 29rpx; }
.create-page .section-note { font-size: 22rpx; }
.form-step { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 44rpx; height: 44rpx; margin-right: 14rpx; border-radius: 14rpx; background: #FFF0E8; color: #AA381B; font-size: 22rpx; }
.form-step.end { background: #EEF4FF; color: #344E86; }
.create-page .field { margin-top: 20rpx; margin-bottom: 20rpx; }
.create-page .label { margin-bottom: 10rpx; font-size: 24rpx; }
.create-page input { height: 90rpx; padding-left: 18rpx; padding-right: 18rpx; border-color: #E7EAF0; border-radius: 16rpx; font-size: 27rpx; }
.create-page textarea { height: 160rpx; border-color: #E7EAF0; font-size: 27rpx; }
.location-heading { display: flex; align-items: center; margin-bottom: 14rpx; color: #475467; font-size: 26rpx; font-weight: 600; }
.location-destination { margin-top: 20rpx; padding-top: 22rpx; border-top: 1rpx solid #EAECF0; }
.contact-summary { display: flex; align-items: center; margin-top: 8rpx; color: #667085; font-size: 24rpx; line-height: 1.7; }
.contact-summary .grow { word-break: break-all; }
.create-page .contact-edit { flex-shrink: 0; margin: 0 0 0 12rpx; padding: 12rpx 0; color: #AA381B; font-size: 23rpx; }
.order-address-picker { min-height: 100rpx; padding: 20rpx; border-color: #E4E7EC; border-radius: 17rpx; background: #F8F9FB; color: #344054; font-size: 27rpx; line-height: 1.7; }
.order-address-picker .grow { min-width: 0; word-break: break-all; }
.order-address-picker .picker-arrow { font-size: 30rpx; }
.order-address-picker.address-placeholder { color: #667085; }
.create-page .address-add { justify-content: flex-start; width: auto; min-height: 44px; margin-top: 2rpx; padding: 12rpx 0; color: #AA381B; font-size: 23rpx; }
.contact-fields { display: flex; align-items: flex-start; padding-top: 14rpx; border-top: 1rpx solid #F0F2F5; }
.contact-fields .field { min-width: 0; margin-top: 0; margin-bottom: 0; }
.contact-name { flex: 2; margin-right: 18rpx; }
.contact-phone { flex: 3; }
.measure-hint { margin-top: 8rpx; color: #667085; font-size: 22rpx; line-height: 1.65; }
.goods-suggestions { display: flex; flex-wrap: wrap; margin: -6rpx -6rpx 16rpx; }
.create-page .suggestion { width: auto; min-width: 44px; min-height: 44px; margin: 6rpx; padding: 12rpx 18rpx; border: 1rpx solid #EAECF0; border-radius: 14rpx; background: #FFFFFF; color: #475467; font-size: 24rpx; font-weight: 500; }
.create-page .suggestion-selected { border-color: #F0CBB9; background: #FFF3EB; color: #AA381B; }
.create-page .more-toggle { justify-content: space-between; margin: 22rpx 0 0; padding: 20rpx 0 4rpx; border-top: 1rpx solid #EAECF0; border-radius: 0; background: transparent; color: #475467; font-size: 25rpx; text-align: left; }
.more-summary { margin-top: 4rpx; color: #667085; font-size: 23rpx; font-weight: 400; }
.more-fields { margin-top: 18rpx; padding: 2rpx 18rpx; border-radius: 16rpx; background: #F8F9FB; }
.publish-actions { margin-top: 22rpx; }
.publish-note { margin: 0 4rpx 16rpx; color: #667085; font-size: 23rpx; line-height: 1.7; }
.create-page .suggestion[disabled], .create-page .more-toggle[disabled], .create-page .contact-edit[disabled] { color: #667085; background: #EAECF0; }
.service-tabs { display: flex; margin-bottom: 22rpx; padding: 8rpx; border-radius: 20rpx; background: #EAECF0; }
.create-page .type-tab { flex: 1; min-height: 44px; margin: 0 4rpx; padding: 14rpx 8rpx; background: transparent; color: #475467; font-size: 26rpx; }
.create-page .type-tab.selected, .create-page .scene-option.selected { background: #FFF3EB; border-color: #C94320; color: #AA381B; }
.scene-options { display: flex; flex-direction: column; margin-top: 18rpx; }
.transport-scenes .scene-options { flex-direction: row; gap: 16rpx; }
.transport-scenes .scene-option { flex: 1; min-width: 0; }
.create-page .scene-option { display: block; margin: 6rpx 0; padding: 20rpx; border: 1rpx solid #E4E7EC; background: #FFFFFF; color: #344054; text-align: left; font-size: 27rpx; }
@media (max-width: 350px) {
  .create-heading .title { font-size: 36rpx; }
  .create-page .card { padding: 22rpx; }
  .contact-fields { flex-direction: column; }
  .contact-fields .field { width: 100%; }
  .contact-fields .contact-name { margin-right: 0; margin-bottom: 18rpx; }
  .contact-summary { align-items: flex-start; flex-direction: column; }
  .create-page .contact-edit { margin-left: 0; }
}
