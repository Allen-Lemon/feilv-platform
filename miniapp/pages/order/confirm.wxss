.confirm-page {
  max-width: 960rpx;
  margin: 0 auto;
  padding: 24rpx 24rpx 40rpx;
  padding-right: calc(24rpx + env(safe-area-inset-right));
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  padding-left: calc(24rpx + env(safe-area-inset-left));
  background: #F7F8FA;
}

.confirm-page .card {
  min-width: 0;
  margin-bottom: 20rpx;
  padding: 28rpx;
  border: 1rpx solid #EAECF0;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: none;
}

.confirm-page button {
  min-width: 44px;
  min-height: 44px;
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  font-size: 27rpx;
}

.confirm-page .confirm-header {
  margin: 8rpx 4rpx 26rpx;
}

.header-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  min-width: 0;
}

.header-caption {
  margin: 0 16rpx 10rpx 0;
  color: #667085;
  font-size: 24rpx;
}

.service-type {
  max-width: 100%;
  margin-bottom: 10rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: #FFF0E8;
  color: #AA381B;
  font-size: 23rpx;
  font-weight: 600;
  word-break: break-all;
}

.confirm-heading {
  margin-top: 8rpx;
  color: #202939;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.35;
  word-break: break-all;
}

.header-description {
  margin-top: 12rpx;
  color: #667085;
  font-size: 25rpx;
  line-height: 1.65;
  word-wrap: break-word;
}

.confirm-page .confirm-mock {
  margin: 20rpx 0;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  font-size: 23rpx;
}

.mock-description {
  flex: 1;
  min-width: 0;
  word-wrap: break-word;
}

.panel-title {
  margin-bottom: 20rpx;
  color: #202939;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.45;
}

.route-node {
  position: relative;
  display: flex;
  align-items: flex-start;
  min-width: 0;
}

.route-origin {
  padding-bottom: 32rpx;
}

.route-origin::before {
  position: absolute;
  top: 48rpx;
  bottom: 6rpx;
  left: 21rpx;
  width: 0;
  border-left: 2rpx dashed #E4E7EC;
  content: "";
}

.route-marker {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  margin-right: 20rpx;
  border-radius: 14rpx;
  background: #FFF0E8;
  color: #AA381B;
  font-size: 23rpx;
  font-weight: 600;
}

.destination-marker {
  background: #EDF0F5;
  color: #344054;
}

.route-content {
  flex: 1;
  min-width: 0;
}

.address-text {
  color: #202939;
  font-size: 29rpx;
  font-weight: 500;
  line-height: 1.6;
  word-break: break-all;
}

.contact-line {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
  color: #667085;
  font-size: 25rpx;
  line-height: 1.6;
  word-break: break-all;
}

.contact-line > text {
  min-width: 0;
  max-width: 100%;
}

.contact-name {
  margin-right: 16rpx;
}

.summary-row {
  display: flex;
  align-items: flex-start;
  min-width: 0;
  padding: 10rpx 0;
  font-size: 26rpx;
  line-height: 1.65;
}

.summary-label {
  flex-shrink: 0;
  width: 152rpx;
  padding-right: 18rpx;
  color: #667085;
}

.summary-value {
  flex: 1;
  min-width: 0;
  color: #344054;
  word-break: break-all;
}

.task-summary {
  margin-top: 24rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F2F5;
}

.fee-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  flex-wrap: wrap;
  min-width: 0;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #F0F2F5;
  font-size: 26rpx;
  line-height: 1.65;
}

.fee-label {
  flex: 1;
  min-width: 0;
  padding-right: 24rpx;
  color: #667085;
  word-break: break-all;
}

.fee-value {
  max-width: 100%;
  color: #344054;
  word-break: break-all;
}

.confirm-total {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  min-width: 0;
  padding-top: 24rpx;
}

.total-label {
  margin: 8rpx 20rpx 8rpx 0;
  color: #344054;
  font-size: 27rpx;
  font-weight: 500;
}

.total-amount {
  min-width: 0;
  max-width: 100%;
  color: #C94320;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.3;
  word-break: break-all;
}

.amount-currency {
  margin-right: 4rpx;
  font-size: 26rpx;
}

.fee-note {
  margin-top: 12rpx;
  color: #667085;
  font-size: 23rpx;
  text-align: right;
}

.confirm-page .submit-panel {
  border-color: #F2D5CA;
}

.confirm-page .submission-notice {
  margin-bottom: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
}

.notice-title {
  margin-bottom: 6rpx;
  font-weight: 600;
}

.created-order-id {
  margin: 4rpx 0;
  word-break: break-all;
}

.duplicate-warning {
  margin-top: 16rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.7;
  word-wrap: break-word;
}

.confirm-page .submit-button {
  background: #C94320;
  color: #FFFFFF;
  box-shadow: none;
}

.secondary-actions {
  margin-top: 20rpx;
  padding-top: 4rpx;
  border-top: 1rpx solid #F0F2F5;
}

.confirm-page .outline-button {
  margin-top: 16rpx;
  border: 1rpx solid #D0D5DD;
  background: #FFFFFF;
  color: #344054;
  box-shadow: none;
}

.confirm-page .quiet-button {
  margin-top: 8rpx;
  padding: 16rpx;
  background: transparent;
  color: #AA381B;
  font-size: 25rpx;
  box-shadow: none;
}

.confirm-page button[disabled] {
  border-color: #EAECF0;
  background: #EAECF0;
  color: #667085;
  box-shadow: none;
}

@media (max-width: 350px) {
  .confirm-page .card {
    padding: 24rpx;
  }

  .confirm-heading {
    font-size: 36rpx;
  }

  .summary-label {
    width: 138rpx;
  }

  .route-marker {
    margin-right: 16rpx;
  }
}
