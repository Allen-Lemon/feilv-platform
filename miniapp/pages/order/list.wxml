<view class="page orders-page">
  <view class="orders-heading">
    <view class="grow"><view class="eyebrow">每份托付，都有回响</view><view class="title">我的订单</view><view class="orders-description">查看配送进度，也回顾每次小小的托付</view></view>
    <button class="secondary small refresh-button" bindtap="refresh" disabled="{{loading || !loggedIn}}">{{loading ? '加载中' : '刷新'}}</button>
  </view>
  <view wx:if="{{loggedIn}}" class="orders-list-note"><view class="list-note-mark"></view><text>订单状态以服务端最新结果为准</text><text class="list-note-action">下拉可刷新</text></view>
  <view class="empty orders-empty" wx:if="{{!loggedIn}}">
    <view class="empty-mark">单</view><view class="empty-title">你的订单，都在这里</view><view class="empty-caption">登录后随时查看订单与配送进度</view><button class="primary" bindtap="login">登录 / 注册</button>
  </view>
  <block wx:else>
    <view class="card orders-error" wx:if="{{error}}"><view class="error">{{error}}</view><button class="secondary small" bindtap="retry" disabled="{{loading}}">重新加载</button></view>
    <button class="card order-card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="detail" hover-class="tap-feedback" aria-label="查看订单详情">
      <view class="order-card-heading">
        <view class="order-service"><view class="order-service-icon type-{{item.orderType}}">{{item.orderType === 'SEND' ? '送' : item.orderType === 'BUY' ? '买' : '办'}}</view><text>{{item.typeText}}</text></view>
        <text class="tag status-{{item.status}}">{{item.statusText}}</text>
      </view>
      <view class="order-route">
        <view class="route-stop"><view class="route-marker"><view class="stop-dot">取</view><view class="route-connector"></view></view><view class="route-address">{{item.fromAddress}}</view></view>
        <view class="route-stop"><view class="route-marker"><view class="stop-dot end">送</view></view><view class="route-address">{{item.toAddress}}</view></view>
      </view>
      <view class="order-goods" wx:if="{{item.goodsDesc}}"><text class="goods-label">物品 / 事项</text><text class="goods-value">{{item.goodsDesc}}</text></view>
      <view class="order-card-footer">
        <view class="order-amount"><text class="amount-label">订单金额</text><text class="amount-value">¥{{item.feeText}}</text></view>
        <view class="order-detail-link {{item.canPay || item.canConfirm ? 'detail-link-primary' : ''}}"><text>{{item.canPay ? '去模拟支付' : item.canConfirm ? '去确认收货' : '查看详情'}}</text><view class="chevron"></view></view>
      </view>
      <view class="order-meta"><view class="order-number">订单号 {{item.orderNo}}</view><view class="order-time">{{item.createdText}}</view></view>
    </button>
    <view class="empty orders-empty" wx:if="{{!list.length && !loading && !error}}"><view class="empty-mark">单</view><view class="empty-title">还没有订单</view><view class="empty-caption">送一份文件，买一份心意，或让我们代办一件小事。</view><button class="primary" bindtap="home">去首页下单</button></view>
    <view class="orders-loading" wx:if="{{loading}}"><view class="loading-dot"></view><text>正在为你加载订单…</text></view>
    <button class="secondary load-more" wx:if="{{hasMore && list.length}}" bindtap="more" disabled="{{loading}}">{{loading ? '正在加载…' : '加载更多订单'}}</button>
    <view class="orders-end" wx:if="{{!hasMore && list.length && !loading}}">— 已展示全部订单 —</view>
  </block>
</view>
