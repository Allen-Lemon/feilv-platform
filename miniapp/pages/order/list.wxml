<view class="page orders-page">
  <view class="orders-heading">
    <view class="grow">
      <view class="title">我的订单</view>
      <view class="orders-description">取送进度，一目了然</view>
    </view>
    <button class="refresh-button" bindtap="refresh" disabled="{{loading || !loggedIn}}">{{loading ? '更新中…' : '刷新'}}</button>
  </view>

  <view class="empty orders-empty" wx:if="{{!loggedIn}}">
    <view class="empty-mark">单</view>
    <view class="empty-title">登录后查看你的订单</view>
    <view class="empty-caption">配送进度与历史记录，都在这里</view>
    <button class="primary" bindtap="login">登录 / 注册</button>
  </view>

  <block wx:else>
    <view class="orders-list-note">下拉刷新进度 · 点击卡片查看完整信息</view>
    <view class="orders-error" wx:if="{{error}}">
      <view class="error">{{error}}</view>
      <button class="retry-button" bindtap="retry" disabled="{{loading}}">重试</button>
    </view>

    <button class="order-card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="detail" hover-class="order-card-pressed" aria-label="{{item.typeText}}，{{item.statusText}}，查看订单{{item.orderNo}}详情">
      <view class="order-card-heading">
        <view class="order-service">
          <view class="order-service-icon type-{{item.orderType}}">{{item.orderType === 'SEND' ? '送' : item.orderType === 'BUY' ? '买' : item.orderType === 'ERRAND' ? '办' : item.orderType === 'CUSTOM' ? '自' : '单'}}</view>
          <view class="service-copy">
            <view class="service-name">{{item.typeText}}</view>
            <view class="order-time">{{item.createdText}}</view>
          </view>
        </view>
        <view class="order-status status-{{item.status}}"><view class="status-dot"></view><text>{{item.statusText}}</text></view>
      </view>

      <view class="order-route">
        <view class="route-stop">
          <view class="route-marker"><view class="stop-dot">取</view><view class="route-connector"></view></view>
          <view class="route-address">{{item.fromAddress || '取件地址未提供'}}</view>
        </view>
        <view class="route-stop">
          <view class="route-marker"><view class="stop-dot end">送</view></view>
          <view class="route-address">{{item.toAddress || '送达地址未提供'}}</view>
        </view>
      </view>

      <view class="order-goods" wx:if="{{item.goodsDesc}}"><text class="goods-label">需求</text><text class="goods-value">{{item.goodsDesc}}</text></view>
      <view class="order-card-footer">
        <view class="order-amount"><text class="amount-label">订单金额</text><text class="amount-value">¥{{item.feeText}}</text></view>
        <view class="order-detail-link {{item.canPay || item.canConfirm ? 'detail-link-primary' : ''}}">{{item.canPay ? '去模拟支付' : item.canConfirm ? '去确认收货' : '查看详情'}}<text class="detail-arrow">›</text></view>
      </view>
      <view class="order-number">订单号 {{item.orderNo}}</view>
    </button>

    <view class="empty orders-empty" wx:if="{{!list.length && !loading && !error}}">
      <view class="empty-mark">单</view>
      <view class="empty-title">还没有订单</view>
      <view class="empty-caption">送物、代买或代办，选个服务开始吧。</view>
      <button class="primary" bindtap="home">去发布任务</button>
    </view>
    <view class="orders-loading" wx:if="{{loading}}"><view class="loading-dot"></view><text>正在加载订单…</text></view>
    <button class="load-more" wx:if="{{hasMore && list.length}}" bindtap="more" disabled="{{loading}}">{{loading ? '正在加载…' : '加载更多订单'}}</button>
    <view class="orders-end" wx:if="{{!hasMore && list.length && !loading}}">— 已展示全部订单 —</view>
  </block>
</view>
