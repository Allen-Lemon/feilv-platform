<view class="page create-page">
  <view class="page-head"><view class="eyebrow">{{typeText}} · 填写需求</view><view class="title">这次，帮你跑一趟</view><view class="page-desc">完善取送信息，再查看服务端预估费用</view></view>
  <view class="notice">请手动填写实际联系人。距离为手工预估，不是地图测距；报价由服务端计算。</view>
  <view class="card"><view class="section-head"><view class="section-title"><text class="form-step">取</text>取件 / 起点</view><button class="secondary small" data-side="from" bindtap="address" disabled="{{busy}}">选地址簿</button></view>
    <view class="field"><text class="label">取件联系人</text><input value="{{form.fromContact}}" data-field="fromContact" bindinput="input" maxlength="30" disabled="{{busy}}" placeholder="请输入姓名"/></view>
    <view class="field"><text class="label">取件手机号</text><input type="number" value="{{form.fromPhone}}" data-field="fromPhone" bindinput="input" maxlength="11" disabled="{{busy}}" placeholder="请输入11位手机号"/></view>
    <view class="field"><text class="label">取件详细地址</text><input value="{{form.fromAddress}}" data-field="fromAddress" bindinput="input" maxlength="200" disabled="{{busy}}" placeholder="街道、楼栋、门牌号"/></view>
  </view>
  <view class="card"><view class="section-head"><view class="section-title"><text class="form-step end">送</text>送达 / 终点</view><button class="secondary small" data-side="to" bindtap="address" disabled="{{busy}}">选地址簿</button></view>
    <view class="field"><text class="label">收件联系人</text><input value="{{form.toContact}}" data-field="toContact" bindinput="input" maxlength="30" disabled="{{busy}}" placeholder="请输入姓名"/></view>
    <view class="field"><text class="label">收件手机号</text><input type="number" value="{{form.toPhone}}" data-field="toPhone" bindinput="input" maxlength="11" disabled="{{busy}}" placeholder="请输入11位手机号"/></view>
    <view class="field"><text class="label">送达详细地址</text><input value="{{form.toAddress}}" data-field="toAddress" bindinput="input" maxlength="200" disabled="{{busy}}" placeholder="街道、楼栋、门牌号"/></view>
  </view>
  <view class="card"><view class="section-title">物品与要求</view>
    <view class="field"><text class="label">物品 / 代办事项</text><input value="{{form.goodsDesc}}" data-field="goodsDesc" bindinput="input" maxlength="128" disabled="{{busy}}" placeholder="例如：文件、鲜花、代取快递"/></view>
    <view class="measure-fields"><view class="field"><text class="label">预估距离 <text class="optional">公里</text></text><input type="digit" value="{{distanceKm}}" data-field="distanceKm" bindinput="number" disabled="{{busy}}" placeholder="例如：2.5"/><view class="measure-hint">手填，大于0且不超过200</view></view><view class="field"><text class="label">物品重量 <text class="optional">公斤</text></text><input type="number" value="{{weightKg}}" data-field="weightKg" bindinput="number" disabled="{{busy}}" maxlength="3"/><view class="measure-hint">1至100的整数</view></view></view>
    <view class="field"><text class="label">备注 <text class="optional">选填</text></text><textarea value="{{form.remark}}" data-field="remark" bindinput="input" maxlength="255" disabled="{{busy}}" placeholder="配送时间、轻拿轻放等"/></view>
    <view class="hint">照片上传与 OCR 尚未接入，不会将本地选图当作已上传。</view>
    <button class="{{quote ? 'secondary' : 'primary'}}" loading="{{busy}}" disabled="{{busy}}" bindtap="calculate">{{quote ? '重新计算费用' : '计算预估费用'}}</button>
  </view>
  <view class="card quote-card" wx:if="{{quote}}"><view class="section-title">费用明细</view><view class="row line" wx:for="{{quote.items}}" wx:key="key"><text class="grow">{{item.label}}</text><text>¥{{item.amountText}}</text></view><view class="row quote-total"><text>预估合计</text><text class="price"><text class="currency">¥</text>{{quote.totalText}}</text></view><button class="primary" disabled="{{busy}}" bindtap="next">下一步，确认订单 →</button></view>
  <view class="footer-note">请核对联系人和地址后再提交</view>
</view>
