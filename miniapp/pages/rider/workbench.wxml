<view class="page"><view class="card" wx:if="{{!allowed}}"><view class="title">需要骑手账户</view><view class="hint">请先登录已入驻的骑手账号，或提交骑手入驻。</view><button class="primary" bindtap="login">去登录</button><button class="secondary" bindtap="register">骑手入驻</button></view>
<block wx:else><view class="card"><view class="title">骑手工作台</view><view wx:if="{{info}}">{{info.name}} · {{modeText}}</view><view class="hint" wx:if="{{info}}">信用分 {{info.creditScore}} · 服务评分 {{info.stars}}</view><view class="error" wx:if="{{error}}">{{error}}</view><view class="actions"><button class="primary" bindtap="online" disabled="{{busy || loading}}">{{online ? '下线休息' : '上线抢单'}}</button><button class="secondary" bindtap="load" disabled="{{busy || loading}}" loading="{{loading}}">刷新工作台</button><button class="secondary" bindtap="credit" disabled="{{busy || loading}}">信用明细</button></view></view>
<view class="notice">仅现有骑手可接单。服务任务无需取件码或配送定位；配送位置只在点击“真实位置上报”并同意后获取，不在后台持续定位。送达照片凭证尚未接入。</view>
<view class="notice" wx:if="{{lastGrabCode}}">{{lastGrabCode}}</view>
<view class="card"><view class="title">骑手抢单大厅</view><view class="empty" wx:if="{{!halls.length}}">{{online ? '暂无可抢订单，点击刷新再试' : '您已下线，上线后查看订单'}}</view><view class="item" wx:for="{{halls}}" wx:key="orderId"><view>{{item.typeText}} · {{item.orderNo}}</view><view class="task-title" wx:if="{{item.title}}">{{item.title}}</view>
<block wx:if="{{item.isService}}"><view class="line">{{item.modeText}}</view><view class="line">{{item.taskMode === 'ONLINE' ? '线上任务 · 无需地址' : item.locationAddress}}</view><view class="hint" wx:if="{{item.serviceTime}}">服务时间：{{item.serviceTime}}</view></block>
<block wx:else><view class="line">取：{{item.fromAddress}}</view><view class="line">送：{{item.toAddress}}</view><view class="hint">{{item.distanceText}} 公里</view></block>
<view class="hint">骑手预计所得 ¥{{item.rewardText}}（非发布总价，最终结算以售后及钱包记录为准）</view><button class="primary" data-id="{{item.orderId}}" bindtap="grab" disabled="{{busy || loading}}">接此任务</button></view></view>
<view class="card"><view class="title">我的承接订单</view><view class="empty" wx:if="{{!orders.length}}">暂无承接订单</view><view class="item" wx:for="{{orders}}" wx:key="id"><view class="row"><text class="muted">{{item.orderNo}}</text><text class="tag">{{item.statusText}}</text></view><view class="task-title" wx:if="{{item.title}}">{{item.title}}</view>
<block wx:if="{{item.isService}}"><view class="line">{{item.modeText}}</view><view class="line">{{item.taskMode === 'ONLINE' ? '线上任务 · 无需地址' : item.locationAddress}}</view><view class="hint" wx:if="{{item.serviceTime}}">服务时间：{{item.serviceTime}}</view></block>
<block wx:else><view class="line">取：{{item.fromAddress}}</view><view class="line">送：{{item.toAddress}}</view></block>
<view class="hint">骑手预计所得 ¥{{item.rewardText}}（非发布总价）</view>
<button class="secondary" data-id="{{item.id}}" bindtap="detail" disabled="{{busy || loading}}">查看任务详情</button>
<block wx:if="{{item.canPickup}}"><input type="text" maxlength="12" value="{{pickupCodes[item.id]}}" data-id="{{item.id}}" bindinput="codeInput" placeholder="核对后手动输入真实取件码" disabled="{{busy || loading}}"/><button class="primary" data-id="{{item.id}}" bindtap="pickup" disabled="{{busy || loading}}">取件码核销</button></block>
<button wx:if="{{item.canDepart}}" class="primary" data-id="{{item.id}}" bindtap="depart" disabled="{{busy || loading}}">出发配送</button>
<block wx:if="{{item.canDeliver}}"><button class="secondary" data-id="{{item.id}}" bindtap="report" disabled="{{busy || loading}}" loading="{{busy}}">真实位置上报</button><button class="primary" data-id="{{item.id}}" bindtap="deliver" disabled="{{busy || loading}}">确认送达（无照片凭证）</button></block>
<button wx:if="{{item.canServiceStart}}" class="primary" data-id="{{item.id}}" bindtap="serviceStart" disabled="{{busy || loading}}">开始服务</button>
<button wx:if="{{item.canServiceComplete}}" class="primary" data-id="{{item.id}}" bindtap="serviceComplete" disabled="{{busy || loading}}">提交完成 · 待用户确认</button>
</view><button wx:if="{{hasMore}}" class="secondary" bindtap="more" disabled="{{busy || loading}}">加载更多承接订单</button></view>
<view class="card" wx:if="{{locationInfo || locationDenied}}"><view class="hint">{{locationInfo}}</view><button wx:if="{{locationDenied}}" class="secondary" bindtap="permission">打开小程序权限设置</button><view class="hint" wx:if="{{locationDenied}}">若系统未启用定位，请到手机系统设置开启定位服务。未取得真实位置时不会上报。</view></view>
<view class="card" wx:if="{{logsVisible}}"><view class="title">信用变动明细</view><view class="empty" wx:if="{{!logs.length}}">暂无信用变动</view><view class="line" wx:for="{{logs}}" wx:key="id"><view>{{item.reason}} · {{item.deltaText}}</view><view class="muted">{{item.createdText}}</view></view></view>
</block></view>
